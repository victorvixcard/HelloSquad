{
  "name": "@hellosquad/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Design System HelloSquad: tokens gerados de tokens.json, fontes locais e primitivos React.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./fonts/*": "./src/fonts/*"
  },
  "scripts": {
    "build:tokens": "node scripts/build-tokens.ts",
    "extract:ds": "node scripts/extract-ds.ts",
    "generate": "node scripts/build-tokens.ts && node scripts/extract-ds.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "30.1.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
}
