# HelloSquad — variáveis do ambiente LOCAL.
# Copie para .env (o .env nunca é commitado) e preencha:  cp .env.example .env
# Nada aqui aponta para nuvem. Guia: docs/SETUP_LOCAL.md.

# Ambiente da aplicação: local | test | staging | production
APP_ENV=local

# Supabase local do projeto "hellosquad" (sobe com `make up`).
SUPABASE_URL=http://127.0.0.1:56321
# Chaves locais: rode `pnpm exec supabase status -o env` e copie
#   ANON_KEY          -> SUPABASE_ANON_KEY          (pública; passa pela RLS)
#   SERVICE_ROLE_KEY  -> SUPABASE_SERVICE_ROLE_KEY  (ignora a RLS; só api/worker/scheduler, nunca no browser)
# A tabela do `make status` mostra só as chaves novas (Publishable/Secret); estas duas aparecem no `-o env`.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres do Supabase local (usuário e senha padrão do CLI; só existem nesta máquina).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres

# API da Anthropic: o dono fornece na Fase 1. Deixe vazio até lá.
ANTHROPIC_API_KEY=

# Portas locais (8000 e 3000 já são usadas por outros projetos nesta máquina).
API_PORT=8100
WEB_PORT=3100
