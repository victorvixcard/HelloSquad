# HelloSquad — variáveis do ambiente LOCAL.
# Copie para .env (o .env nunca é commitado) e preencha:  cp .env.example .env
# Nada aqui aponta para nuvem. Guia: docs/SETUP_LOCAL.md.

# Ambiente da aplicação: local | test | staging | production
APP_ENV=local

# Supabase local do projeto "hellosquad" (sobe com `make up`).
SUPABASE_URL=http://127.0.0.1:56321
# Chaves locais no formato novo: rode `pnpm exec supabase status -o env` e copie
#   PUBLISHABLE_KEY -> SUPABASE_PUBLISHABLE_KEY  (sb_publishable_…: web, app e testes; passa pela RLS)
#   SECRET_KEY      -> SUPABASE_SECRET_KEY       (sb_secret_…: só backend, administração da Auth;
#                                                 nunca no browser, nunca em log)
# As legadas ANON_KEY e SERVICE_ROLE_KEY não são usadas pelo código.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Validação do JWT do usuário na API. Padrão: chave pública do JWKS da Auth
# ({SUPABASE_URL}/auth/v1/.well-known/jwks.json), algoritmo ES256 (o que a Auth local usa).
# Fallback, só se a Auth assinar com segredo compartilhado: AUTH_JWT_ALGORITHMS=HS256 e
# SUPABASE_JWT_SECRET com o JWT_SECRET do `supabase status -o env`. Lista separada por vírgula.
AUTH_JWT_ALGORITHMS=ES256
SUPABASE_JWT_SECRET=

# Postgres do Supabase local.
# DATABASE_URL: usuário postgres (padrão do CLI; ignora a RLS). Só ferramentas locais (seed, testes).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
# API_DATABASE_URL: papel hellosquad_api (sem BYPASSRLS), o único que a API usa. Formato:
#   postgresql://hellosquad_api:<senha>@127.0.0.1:56322/postgres
# Gere a senha local com `openssl rand -hex 24`; `make migrate` (ou `make seed`) a grava no banco.
API_DATABASE_URL=

# LLM do runtime do squad (worker). anthropic = modo real, se ANTHROPIC_API_KEY estiver preenchida;
# sem a chave, o worker cai no modo simulado (respostas das fixtures, sem custo) e avisa no log.
# simulated = sempre simulado, mesmo com chave (os testes usam este). A chave nunca vai para log.
LLM_PROVIDER=anthropic
# API da Anthropic: o dono fornece. Vazia = modo simulado.
ANTHROPIC_API_KEY=

# Busca web da Bia (02.07, pesquisa de concorrentes e tendências). disabled (padrão) = sem busca: a entrega
# diz que tudo é sugestão sem validação. mock = resultados fictícios fixos (.example), para demonstração.
# brave = busca real, só com a chave (fornecedor ainda a escolher pelo dono: Tavily, Brave ou SerpAPI).
WEB_SEARCH_PROVIDER=disabled
WEB_SEARCH_API_KEY=

# Worker: runs simultâneos neste processo e teto de runs simultâneos por workspace (aplicado ao tirar
# da fila; o excedente espera na fila, sem erro). Em local o worker usa DATABASE_URL (papel postgres).
WORKER_CONCURRENCY=4
WORKER_WORKSPACE_CAP=3
# Memória da Marca no contexto de cada run: teto de tokens (estimados). Os essenciais (decisões, Minha
# marca, Meu público) entram sempre e contam no teto; a busca pelo pedido completa até ele.
MEMORY_CONTEXT_TOKENS=1500
# Aprendizados por cliente (camada 3, S2c): quantos promovidos entram por run (dentro do teto acima),
# dias sem "continua valendo" até entrar marcado para revisar, confiança mínima da correção explícita
# para promover sozinha e em quantos trabalhos a mesma lição precisa aparecer para promover por repetição.
LEARNING_TOP_K=5
LEARNING_REVIEW_DAYS=90
LEARNING_PROMOTION_CONFIDENCE=0.7
LEARNING_PROMOTION_REPEATS=2
# Embeddings da memória (ADR-0009): só "disabled" até o dono escolher o fornecedor; a busca é textual por idioma.
EMBEDDINGS_PROVIDER=disabled
# Motor de imagem da Kaia (03.01–03.03): é do dono e ainda não chegou; só "pending" (a etapa aguarda o motor, sem cobrar).
IMAGE_ENGINE_PROVIDER=pending

# Cobrança (S2e, ADR-0008): pagamento recorrente atrás de uma interface única. PAYMENT_PROVIDER escolhe o provedor
# das cobranças novas: asaas | mercadopago | mock (simulado, só local/test). Sem cobrança real até o dono definir
# preço (16/10): sem preço em plan_prices/topup_packs, nada abre no provedor. Chaves vazias: o dono cria as contas
# sandbox e preenche só aqui. O webhook de cada provedor só é aceito com o segredo dele preenchido.
PAYMENT_PROVIDER=mock
# Segredo do webhook simulado (x-mock-signature = HMAC-SHA256 do corpo). Local: openssl rand -hex 24.
PAYMENT_MOCK_WEBHOOK_SECRET=
# Asaas (API v3). Sandbox: https://api-sandbox.asaas.com/v3; produção: https://api.asaas.com/v3.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# authToken cadastrado no webhook do Asaas (32 a 255 caracteres, sem espaço, diferente da chave de API).
ASAAS_WEBHOOK_TOKEN=
# Mercado Pago: Access Token (credenciais de teste do painel) e a assinatura secreta do webhook (Suas integrações).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_WEBHOOK_SECRET=
# Volta do checkout de assinatura do Mercado Pago (back_url).
PAYMENT_BACK_URL=http://127.0.0.1:3100
# Tempo máximo de uma chamada ao provedor (o Asaas pede ao menos 60 s em cobrança por cartão).
PAYMENT_TIMEOUT_SECONDS=60
# Scheduler (renovação mensal): intervalo do tick e minutos entre duas conciliações da mesma assinatura vencida.
SCHEDULER_TICK_SECONDS=60
# Modo Autônomo (S3b): minutos entre a primeira e a segunda tentativa de uma execução (9h e 9h30 no protótipo).
AUTONOMY_RETRY_MINUTES=30
BILLING_RECHECK_MINUTES=60

# E-mail transacional (S2f), atrás do EmailProvider: mailpit = SMTP do Mailpit do Supabase local (sem autenticação;
# caixa em http://127.0.0.1:56324) | mock = em memória. Os dois só em APP_ENV=local/test, onde o worker recusa
# destinatário fora do TLD reservado .example. Provedor de produção (Resend, Postmark, SES…): decisão do dono, Fase 5.
EMAIL_PROVIDER=mailpit
EMAIL_FROM=nao-responda@hellosquad.example
EMAIL_FROM_NAME=HelloSquad
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=56325
# Endereço do web nos links dos e-mails e fuso das datas.
EMAIL_APP_URL=http://127.0.0.1:3100
EMAIL_TIMEZONE=America/Sao_Paulo
# Tentativas por e-mail (backoff: EMAIL_RETRY_BASE_SECONDS × 2^(tentativa-1)).
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_SECONDS=10

# Portas locais (8000 e 3000 já são usadas por outros projetos nesta máquina).
API_PORT=8100
WEB_PORT=3100

# Integrações da onda 1 (Fase 3): Meta (Instagram + Páginas), GA4, Search Console e Google Business Profile.
# Em local tudo aponta para os mocks de infra/mocks (`make mocks`, porta MOCKS_PORT); nenhuma conta real de
# Meta ou Google é criada. Endereços reais (comentados ao lado) só na Fase 5, com go do dono. Guia: docs/MOCKS_LOCAIS.md.
MOCKS_PORT=8300
# Meta. Real: https://www.facebook.com (diálogo OAuth) e https://graph.facebook.com (Graph API).
META_OAUTH_BASE_URL=http://127.0.0.1:8300/meta/www
META_GRAPH_BASE_URL=http://127.0.0.1:8300/meta/graph
META_GRAPH_VERSION=v26.0
# App fictício do mock (o id não é segredo). Segredo vazio: o mock aceita qualquer valor (modo estrito em docs/MOCKS_LOCAIS.md).
META_APP_ID=999000000000001
META_APP_SECRET=
# Google OAuth 2.0. Real: https://accounts.google.com/o/oauth2/v2/auth, https://oauth2.googleapis.com/token e /revoke.
GOOGLE_OAUTH_AUTH_URL=http://127.0.0.1:8300/google/accounts/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=http://127.0.0.1:8300/google/oauth2/token
GOOGLE_OAUTH_REVOKE_URL=http://127.0.0.1:8300/google/oauth2/revoke
# Cliente fictício do mock (o id não é segredo); segredo vazio, como o da Meta.
GOOGLE_CLIENT_ID=000000000000-hellosquadlocal.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# APIs do Google. Real: https://analyticsdata.googleapis.com, https://analyticsadmin.googleapis.com,
# https://searchconsole.googleapis.com, https://mybusinessaccountmanagement.googleapis.com,
# https://mybusinessbusinessinformation.googleapis.com e https://mybusiness.googleapis.com (v4: localPosts e reviews).
GOOGLE_GA4_DATA_BASE_URL=http://127.0.0.1:8300/google/analyticsdata
GOOGLE_GA4_ADMIN_BASE_URL=http://127.0.0.1:8300/google/analyticsadmin
GOOGLE_SEARCH_CONSOLE_BASE_URL=http://127.0.0.1:8300/google/searchconsole
GOOGLE_BUSINESS_ACCOUNTS_BASE_URL=http://127.0.0.1:8300/google/mybusinessaccountmanagement
GOOGLE_BUSINESS_INFO_BASE_URL=http://127.0.0.1:8300/google/mybusinessbusinessinformation
GOOGLE_BUSINESS_V4_BASE_URL=http://127.0.0.1:8300/google/mybusiness

# Web (Next.js). O web lê este mesmo .env da raiz (apps/web/next.config.ts) e só recebe valores públicos.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
# Mesmo valor de SUPABASE_PUBLISHABLE_KEY (sb_publishable_…). Nunca a secret: o web recusa sb_secret_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Endereço público do site (canonical, sitemap, Open Graph). Local: o próprio web.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100
# API vista pelo servidor do Next (Server Components e Server Actions). O browser não chama a API direto.
API_URL=http://127.0.0.1:8100
